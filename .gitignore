# Ignore Python bytecode and caches
__pycache__/
*.py[cod]

# macOS metadata
.DS_Store

# Virtual serial pairs are created locally by the emulator.
/ttyV0
/ttyV1

# VS Code settings
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json

# JetBrains IDEs
.idea/**
!.idea/codeStyles/
!.idea/runConfigurations/
*.iml
# ignore workspace files
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/usage.statistics.xml
*.egg-info/


# Tauri experiments
experiments/tauri_data_logger/node_modules/
experiments/tauri_data_logger/dist/
experiments/tauri_data_logger/src-tauri/target/

# Build artifacts
build/
dist/

# Origin & temp artifacts
*.opj
*.opju
*.og?
OriginC/OC??Tmp*/
*.opju_backup
*.tmp
.DS_Store

# Virtual environments
.venv/
.venv-wsl/

# Local runtime logs and visual/debug artifacts
logs/**
!logs/.gitkeep
artifacts/
output/
pytest-cache-files-*/

# Local per-worktree scratch notes
.worktree-notes/

# Research inputs are external; controlled validation copies belong in artifacts/.
/sample_data/
