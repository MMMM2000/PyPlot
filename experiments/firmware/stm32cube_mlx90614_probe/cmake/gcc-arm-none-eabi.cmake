set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

if(DEFINED ENV{STM32_GNU_TOOLS_ROOT})
    set(TOOLCHAIN_ROOT "$ENV{STM32_GNU_TOOLS_ROOT}")
elseif(DEFINED ENV{STM32CUBECLT_ROOT})
    set(TOOLCHAIN_ROOT "$ENV{STM32CUBECLT_ROOT}/GNU-tools-for-STM32/bin")
elseif(DEFINED ENV{STM32_CUBECLT_ROOT})
    set(TOOLCHAIN_ROOT "$ENV{STM32_CUBECLT_ROOT}/GNU-tools-for-STM32/bin")
else()
    file(GLOB _cubeclt_roots LIST_DIRECTORIES true "C:/ST/STM32CubeCLT_*")
    if(_cubeclt_roots)
        list(SORT _cubeclt_roots COMPARE NATURAL ORDER DESCENDING)
        list(GET _cubeclt_roots 0 _cubeclt_root)
        set(TOOLCHAIN_ROOT "${_cubeclt_root}/GNU-tools-for-STM32/bin")
    else()
        set(TOOLCHAIN_ROOT "C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin")
    endif()
endif()

if(NOT EXISTS "${TOOLCHAIN_ROOT}/arm-none-eabi-gcc.exe")
    message(FATAL_ERROR "GNU Arm toolchain was not found at ${TOOLCHAIN_ROOT}. Install STM32CubeCLT or set STM32_GNU_TOOLS_ROOT/STM32CUBECLT_ROOT.")
endif()

set(CMAKE_C_COMPILER "${TOOLCHAIN_ROOT}/arm-none-eabi-gcc.exe")
set(CMAKE_ASM_COMPILER "${TOOLCHAIN_ROOT}/arm-none-eabi-gcc.exe")
set(CMAKE_OBJCOPY "${TOOLCHAIN_ROOT}/arm-none-eabi-objcopy.exe")
set(CMAKE_SIZE "${TOOLCHAIN_ROOT}/arm-none-eabi-size.exe")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
